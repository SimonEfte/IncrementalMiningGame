      talentDescString = $\"\"\uAC01 \uCC44\uAD74 \uC138\uC158\uC774 \uC2DC\uC791\uB420
      \uB54C, \uCC44\uAD74 \uAD6C\uC5ED\uC774 {LevelMechanics.midasTouchChance}%
      \uD655\uB960\uB85C \uD669\uAE08\uC73C\uB85C \uBCC0\uD569\uB2C8\uB2E4. \uC774\uB807\uAC8C
      \uB418\uBA74 \uACE1\uAD2D\uC774 \uD0C0\uACA9\uB9C8\uB2E4 {LevelMechanics.midasTouchSpawnChance}%
      \uD655\uB960\uB85C \uAD11\uC11D\uC774 \uC0DD\uC131\uB429\uB2C8\uB2E4.\"\"; 
      closeString = \"\"\uB2EB\uAE30\"\";\n            purchaseText.text = \"\"\uAD6C\uB9E4\"\";  
      aCircle.text = \"\"\uD654\uBA74\uC744 \uD130\uCE58\uD55C \uACF3\uC744 \uB530\uB77C
      \uC6D0\uC774 \uC774\uB3D9\uD558\uBA70, \uC774\uAC83\uC774 \uCC44\uAD74 \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
      \uCC44\uAD74 \uAD6C\uC5ED \uC548\uC758 \uBC14\uC704\uC5D0\uC11C\uB294 \uACE1\uAD2D\uC774\uAC00
